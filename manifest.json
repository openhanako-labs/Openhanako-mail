{
  "manifestVersion": 2,
  "id": "hanako-mail",
  "name": "Hanako Mail",
  "version": "0.4.2",
  "description": "多邮箱聚合管理：ClawEmail / AgentQQ 官方 API + 个人邮箱 IMAP/SMTP，支持多账号、文件夹、已读未读、回复、搜索、AI 总结翻译与实时收件通知。",
  "minAppVersion": "0.946.2",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn",
    "app/runtime.execute",
    "app/runtime.native",
    "app/runtime.network",
    "app/models.read",
    "app/provider.credentials.read",
    "app/ui.open-external",
    "app/ui.clipboard-write"
  ],
  "contributes": {
    "cards": [
      {
        "id": "mail-page",
        "title": "邮件",
        "description": "多邮箱聚合管理：IMAP/SMTP + 官方 API",
        "route": "/mail.html",
        "cardForm": "flush",
        "face": { "image": "face.png" }
      }
    ]
  }
}
