# Hanako Mail 后端环境变量示例
# 复制为 backend/.env 后按需填写（.env 已被 .gitignore 忽略，不会提交）。
# 说明：账号凭据优先通过插件 UI 填写并加密存储于 accounts.json；
#       此文件仅作为可选兜底，当未通过账号配置提供时生效。

# ── ClawEmail 官方 API（@claw.163.com）──
# CLAWEMAIL_API_KEY=your_clawemail_api_key_here
# CLAWEMAIL_ADDRESS=you@claw.163.com

# ── 个人邮箱 IMAP（读取）──
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASS=your_imap_auth_code

# ── 个人邮箱 SMTP（发送）──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=your_smtp_auth_code

# ── AI 总结/翻译（OpenAI 兼容端点，兜底；正常情况由 Hanako 宿主/agent 配置提供）──
# HANAKO_LLM_BASE_URL=https://api.openai.com/v1
# HANAKO_LLM_API_KEY=
# HANAKO_LLM_MODEL=gpt-4o-mini
